# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001
API_KEY=your-secret-api-key-here

# CORS Configuration (comma-separated list of allowed origins, or "*" for all)
# For production, specify exact origins: http://localhost:8080,https://yourdomain.com
CORS_ORIGINS=*

# Database Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L12-v2
LLM_MODEL=llama3
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Case Management
CASES_DB_PATH=./data/cases.db

# Graph Storage
GRAPHS_DIRECTORY=./data/graphs

# Data Paths
DATA_DIRECTORY=./data
IEEE_CIS_DATA_PATH=./data/ieee_cis
SEBI_DATA_PATH=./data/sebi

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Keys (IMPORTANT: Use environment variables for production!)
API_KEY_DEV=dev-api-key
API_KEY_ANALYST=analyst-key-001